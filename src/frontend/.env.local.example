# Copy to .env.local and adjust once the Python backend exists.
# docs/spec/pipeline/interfaces/dashboard-backend.md

# Base URL of the Dashboard Backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "true" (default) uses the in-memory mock client (lib/api/mocks). Set to
# "false" to call NEXT_PUBLIC_API_BASE_URL for real.
NEXT_PUBLIC_USE_MOCK_API=true

# Mock-mode-only: base URL (categories root, e.g. bh/, sm/ live under this)
# used purely to render gallery-picker thumbnails via <img src> when there's
# no real backend running. Has no effect once NEXT_PUBLIC_USE_MOCK_API=false
# -- the real gallery listing/base URL lives server-side in
# src/backend/.env (IMAGE_GALLERY_BASE_URL/IMAGE_GALLERY_PATH), since the
# browser never talks to that server directly (see src/backend/gallery.py
# for why).
NEXT_PUBLIC_MOCK_GALLERY_BASE_URL=https://cvp.iamemacs.com/api/images
