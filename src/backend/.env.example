# Copy to .env and adjust. Only read by src/backend/gallery.py -- the
# browser never talks to the gallery server directly (it sends no CORS
# headers), so all of this config lives server-side only.

# Base origin of the external sample-image gallery server.
IMAGE_GALLERY_BASE_URL=https://cvp.iamemacs.com

# Path (under the base URL) to the specific image category to list/serve.
IMAGE_GALLERY_PATH=/api/images/bh

# Frontend dev origin allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:3000
