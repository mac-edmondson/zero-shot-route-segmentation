# Copy to .env and adjust. Only read by src/backend/gallery.py -- the
# browser never talks to the gallery server directly (it sends no CORS
# headers), so all of this config lives server-side only.

# Base origin of the external sample-image gallery server.
IMAGE_GALLERY_BASE_URL=https://cvp.iamemacs.com

# Path (under the base URL) to the *categories root* -- a directory of
# subdirectories (e.g. bh/, bh-phone/, model/, sm/), each holding the actual
# images. NOT a specific category itself; the picker lists categories first
# (GET /gallery/categories), then images within whichever one is chosen
# (GET /gallery/images?category=...).
IMAGE_GALLERY_PATH=/api/images

# Frontend dev origin allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:3000
